# =============================================================================
# ENVIRONMENT VARIABLES
# =============================================================================
# Copy this file to .env.local and fill in the values.
#
# Next.js inlines NEXT_PUBLIC_* variables at build time, so changing them
# requires `npm run build` rather than just restarting the dev server.

# -----------------------------------------------------------------------------
# SITE URL
# -----------------------------------------------------------------------------
# The canonical origin. Used for the sitemap, robots.txt, and to make OG image
# URLs absolute (LinkedIn and WhatsApp need them). Set to your production domain
# in Vercel's environment variables.
NEXT_PUBLIC_SITE_URL=https://your-domain.com

# -----------------------------------------------------------------------------
# ANALYTICS
# -----------------------------------------------------------------------------
# Master switch. Set to "false" to disable tracking entirely, regardless of
# provider. Defaults to enabled.
NEXT_PUBLIC_ANALYTICS_ENABLED=true

# Which backend to use: "vercel" or "plausible". Anything else falls back to
# off, so a typo degrades to no tracking rather than throwing.
NEXT_PUBLIC_ANALYTICS_PROVIDER=vercel

# Plausible only: the site identifier the script is registered against.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=your-domain.com

# Plausible only: overridable for a self-hosted or proxied script. Defaults to
# the public Plausible service.
# NEXT_PUBLIC_PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js

# -----------------------------------------------------------------------------
# ADMIN PANEL + DATABASE
# -----------------------------------------------------------------------------
# The admin panel (/admin) is protected by a signed session cookie and stores
# everything in MongoDB. None of these variables are prefixed NEXT_PUBLIC_ —
# they are server-only and must never reach the browser.

# MongoDB connection string from Atlas (Server → Drivers → Node.js). Include
# the database name, e.g. mongodb+srv://user:pass@cluster0.xxxxx.mongodb.net/website?retryWrites=true&w=majority
MONGODB_URI=

# Email that unlocks the admin panel. Login compares this with bcrypt, so keep
# it lowercase and set ADMIN_PASSWORD_HASH to the hash of your password.
ADMIN_EMAIL=

# bcrypt hash of the admin password. The easiest way to set it is:
#   npm run reset-password          (prompts, hashes, and writes this file for you)
#
# If you set it by hand with `npm run hash-password`, escape every `$` as `\$`:
# Next.js expands `$NAME` in .env files, so a raw `$2b$12$...` hash gets mangled.
ADMIN_PASSWORD_HASH=

# Long random string used to sign the session cookie. `npm run reset-password`
# generates one for you if this is empty; or run:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
